# Canonical URL of this marketing site (no trailing slash).
# On Vercel, set to your marketing deployment URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# RentFit product app — rentfit-v1-web (no trailing slash).
# Production: https://rentfit-v1-web.vercel.app (also the default if this line is omitted).
# Local: point at your dev server, e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=https://rentfit-v1-web.vercel.app
